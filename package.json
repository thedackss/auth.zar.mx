{
    "name": "@zar/auth",
    "version": "0.0.1",
    "description": "",
    "author": "",
    "private": true,
    "license": "UNLICENSED",
    "scripts": {
        "postinstall": "prisma generate",
        "build": "nest build",
        "format": "biome check --write",
        "start": "nest start",
        "start:dev": "nest start --watch",
        "start:debug": "nest start --debug --watch",
        "start:prod": "pnpm migrate:deploy && node dist/src/main",
        "migrate:deploy": "prisma migrate deploy",
        "migrate:dev": "prisma migrate dev",
        "openapi:export": "nest build && node dist/src/scripts/generate-openapi.js",
        "panel:dev": "pnpm --dir panel dev",
        "panel:build": "pnpm --dir panel build",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:cov": "jest --coverage",
        "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
        "test:e2e": "jest --config ./test/jest-e2e.json"
    },
    "dependencies": {
        "@bull-board/api": "^7.2.1",
        "@bull-board/express": "^7.2.1",
        "@nestjs/bullmq": "^11.0.4",
        "@nestjs/common": "^11.1.27",
        "@nestjs/core": "^11.1.27",
        "@nestjs/platform-express": "^11.1.27",
        "@nestjs/serve-static": "^5.0.5",
        "@nestjs/swagger": "^11.4.4",
        "@nestjs/throttler": "^6.5.0",
        "@prisma/adapter-pg": "^7.8.0",
        "@prisma/client": "^7.8.0",
        "bcryptjs": "^3.0.3",
        "bullmq": "^5.79.1",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.15.1",
        "cookie-parser": "^1.4.7",
        "dotenv": "^17.4.2",
        "ioredis": "^5.11.1",
        "jsonwebtoken": "^9.0.3",
        "nestjs-pino": "^4.6.1",
        "pino": "^10.3.1",
        "pino-http": "^11.0.0",
        "reflect-metadata": "^0.2.2",
        "resend": "^6.14.0",
        "rxjs": "^7.8.2",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.0",
        "@nestjs/cli": "^11.0.23",
        "@nestjs/schematics": "^11.1.0",
        "@nestjs/testing": "^11.1.27",
        "@types/cookie-parser": "^1.4.10",
        "@types/express": "^5.0.6",
        "@types/jest": "^30.0.0",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^24.13.2",
        "@types/supertest": "^7.2.0",
        "@usebruno/cli": "^3.4.2",
        "jest": "^30.4.2",
        "pino-pretty": "^13.1.3",
        "prisma": "^7.8.0",
        "source-map-support": "^0.5.21",
        "supertest": "^7.2.2",
        "ts-jest": "^29.4.11",
        "ts-loader": "^9.6.1",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^5.9.3"
    },
    "jest": {
        "moduleFileExtensions": [
            "js",
            "json",
            "ts"
        ],
        "rootDir": "src",
        "testRegex": ".*\\.spec\\.ts$",
        "transform": {
            "^.+\\.(t|j)s$": "ts-jest"
        },
        "moduleNameMapper": {
            "^@/(.*)$": "<rootDir>/$1",
            "^(\\.{1,2}/.*)\\.js$": "$1"
        },
        "collectCoverageFrom": [
            "**/*.(t|j)s"
        ],
        "coverageDirectory": "../coverage",
        "testEnvironment": "node"
    }
}
