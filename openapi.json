        "/api/audit/events": {
            "get": {
                "operationId": "AuditController_findAll",
                "parameters": [
                    {
                        "name": "userId",
                        "required": false,
                        "in": "query",
                        "description": "Filter by the affected user's id.",
                        "schema": {
                            "format": "uuid",
                            "type": "string"
                        }
                    },
                    {
                        "name": "type",
                        "required": false,
                        "in": "query",
                        "description": "Filter by event type.",
                        "schema": {
                            "example": "SIGN_IN_FAILURE",
                            "type": "string",
                            "enum": [
                                "SIGN_UP",
                                "SIGN_UP_FAILURE",
                                "SIGN_IN_SUCCESS",
                                "SIGN_IN_FAILURE",
                                "SIGN_OUT",
                                "SIGN_OUT_ALL",
                                "EMAIL_VERIFIED",
                                "PASSWORD_SET",
                                "PASSWORD_CHANGED",
                                "PASSWORD_RECOVER_REQUESTED",
                                "ROLE_CHANGED",
                                "ACCOUNT_DISABLED",
                                "ACCOUNT_ENABLED",
                                "APP_CREATED",
                                "APP_UPDATED",
                                "APP_KEY_REGENERATED",
                                "APP_REVOKED",
                                "APP_ACCESS_GRANTED",
                                "APP_ACCESS_REVOKED",
                                "APP_TOKEN_DENIED",
                                "APP_TOKEN_ISSUED"
                            ]
                        }
                    },
                    {
                        "name": "email",
                        "required": false,
                        "in": "query",
                        "description": "Filter by the email recorded on the event (useful for failed\nsign-ins against unknown accounts).",
                        "schema": {
                            "format": "email",
                            "type": "string"
                        }
                    },
                    {
                        "name": "page",
                        "required": true,
                        "in": "query",
                        "description": "Page to retrieve (from 1).",
                        "schema": {
                            "minimum": 1,
                            "default": 1,
                            "example": 1,
                            "type": "number"
                        }
                    },
                    {
                        "name": "limit",
                        "required": true,
                        "in": "query",
                        "description": "Items per page (max 100).",
                        "schema": {
                            "minimum": 1,
                            "maximum": 100,
                            "default": 20,
                            "example": 20,
                            "type": "number"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": ""
                    }
                },
                "security": [
                    {
                        "cookie": []
                    }
                ],
                "tags": ["audit"]
            }
        },
