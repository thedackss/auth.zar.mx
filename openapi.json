  "info": {
    "title": "Zar Auth API",
    "description": "Authentication and authorization service for zar.mx",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "session.id"
      }
    },
    "schemas": {
      "UpdateUserRoleDto": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "description": "Role to assign to the user.",
            "example": "ADMIN",
            "enum": [
              "USER",
              "ADMIN"
            ]
          }
        },
        "required": [
          "role"
        ]
      },
      "SignUpDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "description": "Email address for the new account. Normalized to lowercase.",
            "example": "empleado@hotel.com",
            "maxLength": 254,
            "format": "email"
          },
          "password": {
            "type": "string",
            "description": "Account password. Must be strong: mix of upper/lowercase, number, and symbol.",
            "example": "{{password}}",
            "maxLength": 128
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "SignInDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "description": "Email address of the account.",
            "example": "empleado@hotel.com",
            "maxLength": 254,
            "format": "email"
          },
          "password": {
            "type": "string",
            "description": "Account password.",
            "example": "{{password}}",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "SetPasswordDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "description": "Single-use token from the invitation email.",
            "example": "kJ8xq2rP-nV4wYt1aZ7bC3dE6fG9hL0m",
            "minLength": 16,
            "maxLength": 256
          },
          "password": {
            "type": "string",
            "description": "New password. Must be strong: mix of upper/lowercase, number, and symbol.",
            "example": "{{password}}",
            "maxLength": 128
          }
        },
        "required": [
          "token",
          "password"
        ]
      },
      "ChangePasswordDto": {
        "type": "object",
        "properties": {
          "currentPassword": {
            "type": "string",
            "description": "The account's current password.",
            "example": "{{password}}",
            "minLength": 1,
            "maxLength": 128
          },
          "newPassword": {
            "type": "string",
            "description": "New password. Must be strong: mix of upper/lowercase, number, and symbol.",
            "example": "{{newPassword}}",
            "maxLength": 128
          }
        },
        "required": [
          "currentPassword",
          "newPassword"
        ]
      },
      "UpdateSettingsDto": {
        "type": "object",
        "properties": {
          "signupEnabled": {
            "type": "boolean",
            "description": "Whether anyone can sign up. When false, only whitelisted emails can.",
            "example": false
          },
          "signupWhitelist": {
            "description": "Emails allowed to sign up while sign-up is disabled.\nExact emails or domain wildcards.",
            "example": [
              "boss@geoil.com",
              "*@geoil.com"
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
