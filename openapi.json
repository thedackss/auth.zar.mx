    "info": {
        "title": "Zar Auth API",
        "description": "Authentication and authorization service for zar.mx",
        "version": "1.0",
        "contact": {}
    },
    "tags": [],
    "servers": [],
    "components": {
        "securitySchemes": {
            "cookie": {
                "type": "apiKey",
                "in": "cookie",
                "name": "zar.session.id"
            }
        },
        "schemas": {
            "UpdateUserRoleDto": {
                "type": "object",
                "properties": {
                    "role": {
                        "type": "string",
                        "description": "Role to assign to the user.",
                        "example": "ADMIN",
                        "enum": ["USER", "ADMIN"]
                    }
                },
                "required": ["role"]
            },
            "SignUpDto": {
                "type": "object",
                "properties": {
                    "email": {
                        "type": "string",
                        "description": "Email address for the new account. Normalized to lowercase.",
                        "example": "user@domain.tld",
                        "maxLength": 254,
                        "format": "email"
                    },
                    "password": {
                        "type": "string",
                        "description": "Account password. Must be strong: mix of upper/lowercase, number, and symbol.",
                        "example": "{{password}}",
                        "maxLength": 128
                    },
                    "lang": {
                        "description": "Language for the account's emails (\"en\" default). Consumer apps pass\nthe language of the page the user signed up from.",
                        "example": "es",
                        "enum": ["en", "es"],
                        "type": "string"
                    }
                },
                "required": ["email", "password"]
            },
            "SignInDto": {
                "type": "object",
                "properties": {
                    "email": {
                        "type": "string",
                        "description": "Email address of the account.",
                        "example": "empleado@hotel.com",
                        "maxLength": 254,
                        "format": "email"
                    },
                    "password": {
                        "type": "string",
                        "description": "Account password.",
                        "example": "{{password}}",
                        "minLength": 1,
                        "maxLength": 128
                    }
                },
                "required": ["email", "password"]
            },
            "RecoverPasswordDto": {
                "type": "object",
                "properties": {
                    "email": {
                        "type": "string",
                        "description": "Email address of the account to recover.",
                        "example": "user@example.com",
                        "maxLength": 254,
                        "format": "email"
                    }
                },
                "required": ["email"]
            },
            "SetPasswordDto": {
                "type": "object",
                "properties": {
                    "token": {
                        "type": "string",
                        "description": "Single-use token from the invitation email.",
                        "example": "kJ8xq2rP-nV4wYt1aZ7bC3dE6fG9hL0m",
                        "minLength": 16,
                        "maxLength": 256
                    },
                    "password": {
                        "type": "string",
                        "description": "New password. Must be strong: mix of upper/lowercase, number, and symbol.",
                        "example": "{{password}}",
                        "maxLength": 128
                    }
                },
                "required": ["token", "password"]
            },
            "ChangePasswordDto": {
                "type": "object",
                "properties": {
                    "currentPassword": {
                        "type": "string",
                        "description": "The account's current password.",
                        "example": "{{password}}",
                        "minLength": 1,
                        "maxLength": 128
                    },
                    "newPassword": {
                        "type": "string",
                        "description": "New password. Must be strong: mix of upper/lowercase, number, and symbol.",
                        "example": "{{newPassword}}",
                        "maxLength": 128
                    }
                },
                "required": ["currentPassword", "newPassword"]
            },
            "UpdateSettingsDto": {
                "type": "object",
                "properties": {
                    "signupEnabled": {
                        "type": "boolean",
                        "description": "Allows direct public sign-up on auth.zar.mx itself. App-mediated\nsign-up is governed per app, not by this flag.",
                        "example": false
                    }
                }
            },
            "CreateAppDto": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string",
                        "example": "anyxa",
                        "minLength": 2,
                        "maxLength": 64
                    },
                    "url": {
                        "type": "string",
                        "example": "https://app.domain.tld",
                        "maxLength": 255,
                        "format": "uri"
                    },
                    "public": {
                        "type": "boolean",
                        "description": "Public apps accept any zar user; private apps require access grants.",
                        "example": false
                    },
                    "confidential": {
                        "type": "boolean",
                        "description": "Server-side app whose key never reaches a browser. Only confidential\napps may forward their visitor's X-Client-IP / X-Client-User-Agent.",
                        "example": true
                    }
                },
                "required": ["name", "public"]
            },
            "UpdateAppDto": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string",
                        "example": "anyxa",
                        "minLength": 2,
                        "maxLength": 64
                    },
                    "url": {
                        "type": "string",
                        "example": "https://app.domain.tld",
                        "maxLength": 255,
                        "format": "uri"
                    },
                    "public": {
                        "type": "boolean",
                        "description": "Public apps accept any zar user; private apps require access grants.",
                        "example": false
                    },
                    "confidential": {
                        "type": "boolean",
                        "description": "Server-side app whose key never reaches a browser. Only confidential\napps may forward their visitor's X-Client-IP / X-Client-User-Agent.",
                        "example": true
                    }
                }
            },
            "GrantAccessDto": {
                "type": "object",
                "properties": {
                    "email": {
                        "type": "string",
                        "description": "Email to grant. Binds to the existing user with that email, or\npre-authorizes the email to sign up through this app.",
                        "example": "user@example.com",
                        "maxLength": 254,
                        "format": "email"
                    }
                },
                "required": ["email"]
            },
            "SendMessageDto": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string",
                        "description": "Sender's name.",
                        "example": "Jane Doe",
                        "minLength": 1,
                        "maxLength": 100
                    },
                    "email": {
                        "type": "string",
                        "description": "Sender's email; replies go there.",
                        "example": "user@domain.tld",
                        "maxLength": 254,
                        "format": "email"
                    },
                    "message": {
                        "type": "string",
                        "description": "The message body.",
                        "example": "Hi, I need a website for my shop.",
                        "minLength": 1,
                        "maxLength": 3000
                    },
                    "lang": {
                        "type": "string",
                        "description": "Language of the page the form was on; drives the stored locale.",
                        "example": "es",
                        "enum": ["en", "es"]
                    },
                    "website": {
                        "type": "string",
                        "description": "Honeypot: a hidden field real visitors never fill. A non-empty value\nmakes the request succeed without storing or sending anything.",
