# "development" or "production". Production turns on rate limiting,
# strict/secure cookies, and hides Swagger UI (/docs).
NODE_ENV=development

# Port the HTTP server listens on.
PORT=3000

# Browser origins allowed to call this API with cookies (CORS).
# Separate multiple origins with ";". The urls of registered (non-revoked)
# apps are also allowed automatically; this list is for everything else.
CORS_ORIGINS="http://localhost;http://localhost:3000"

# Public base URL of this service. Used to build the links sent in
# verification and set-password emails.
APP_URL="http://localhost:3000"

# On startup, if no admin exists yet, this email is promoted to ADMIN
# (or created and sent a set-password invite). Ignored once an admin exists.
ADMIN_EMAIL="admin@example.com"

# Postgres connection string (Prisma).
DATABASE_URL="postgresql://user:password@host:5432/database?schema=public"

# Redis connection string. Stores sessions and the email queue (BullMQ).
REDIS_URL="redis://default:password@host:6379/0"

# Secret used to sign the JWTs issued by POST /auth/token. Any service that
# verifies those tokens needs this same value. Min 32 chars; generate with:
# openssl rand -base64 32
AUTH_SECRET="your_auth_secret_here"

# How long a session lives (and its cookie). 604800 = 7 days.
# Refreshed on every authenticated request.
SESSION_TTL_SECONDS=604800

# Name of the session cookie set in the browser.
SESSION_COOKIE_NAME="session.id"

# Lifetime of the short-lived JWTs from POST /auth/token. Keep it short:
# these tokens cannot be revoked, only expire.
JWT_TTL_SECONDS=60

# Optional. "log" prints emails to the console instead of sending them;
# "resend" sends for real. Defaults: "log" in development, "resend" in
# production. Set MAIL_DRIVER="resend" here to test real sends locally.
# MAIL_DRIVER="resend"

# API key for Resend (https://resend.com), the email provider.
# Only required when MAIL_DRIVER resolves to "resend".
RESEND_API_KEY="re_your_api_key_here"

# From header for outgoing emails. The domain must be verified in Resend.
MAIL_FROM="zar <email@domain.tld>"

# Optional. Monitored inbox that receives replies to the no-reply sender.
# Leave unset to send emails without a Reply-To header.
# MAIL_REPLY_TO="email@domain.tld"
