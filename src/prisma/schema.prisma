generator client {
  provider        = "prisma-client"
  output          = "./generated"
  moduleFormat    = "cjs"
  runtime         = "nodejs"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [citext]
}

enum Role {
  USER
  ADMIN

  @@map("role")
}

model User {
  id    String @id @default(uuid(7))
  email String @unique @db.Citext

  role Role @default(USER)

  emailVerifiedAt DateTime? @map("email_verified_at")
  disabledAt      DateTime? @map("disabled_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  authCredentials AuthCredential[]
  appAccesses     AppAccess[]

  @@map("users")
}

// Single-row table (id is always "default") holding runtime app configuration.
model AppSettings {
  id String @id @default("default")

  // Allows direct public sign-up on auth.zar.mx itself. App-mediated
  // sign-up is governed per-app (App.public / AppAccess), not by this.
  signupEnabled Boolean @default(false) @map("signup_enabled")

  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}

// A registered downstream application (a zar app). Apps authenticate
// server-to-server with an API key (only its sha256 hash is stored).
// Public apps accept any zar user; private apps require an AppAccess grant.
model App {
  id   String  @id @default(uuid(7))
  name String  @unique @db.Citext
  url  String?

  public  Boolean @default(false)
  keyHash String  @unique @map("key_hash")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  revokedAt DateTime? @map("revoked_at")

  accesses AppAccess[]

  @@map("apps")
}

// Per-user (or pre-authorized email) access to a private app. Exactly one
// of userId/email is set: email grants let that address sign up through the
// app and convert to user grants on registration.
model AppAccess {
  id    String @id @default(uuid(7))
  appId String @map("app_id")

  userId String? @map("user_id")
  email  String? @db.Citext

  // Admin who granted it; null when auto-granted at app sign-up.
  grantedBy String?  @map("granted_by")
  createdAt DateTime @default(now()) @map("created_at")

  app  App   @relation(fields: [appId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([appId, userId])
  @@unique([appId, email])
  @@index([userId])
  @@map("app_accesses")
}

model AuthCredential {
  id     String @id @default(uuid(7))
  userId String @map("user_id")

  provider          String
  providerAccountId String @map("provider_account_id")

  passHash      String? @map("pass_hash")
  passAlgorithm String? @map("pass_algorithm")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@unique([userId, provider])
  @@index([userId])
  @@map("auth_credentials")
}

enum AuthEventType {
  SIGN_UP
  SIGN_IN_SUCCESS
  SIGN_IN_FAILURE
  SIGN_OUT
  SIGN_OUT_ALL
  EMAIL_VERIFIED
  PASSWORD_SET
  PASSWORD_CHANGED
  PASSWORD_RECOVER_REQUESTED
  ROLE_CHANGED
  ACCOUNT_DISABLED
  ACCOUNT_ENABLED
  APP_CREATED
  APP_UPDATED
  APP_KEY_REGENERATED
  APP_REVOKED
  APP_ACCESS_GRANTED
  APP_ACCESS_REVOKED
  APP_TOKEN_DENIED

  @@map("auth_event_type")
}

// Audit trail. Intentionally no FK to users: audit rows must survive any
// user row change, and failed sign-ins may not resolve to a user at all.
model AuthEvent {
  id   String        @id @default(uuid(7))
  type AuthEventType

  // Subject of the event; null when unresolvable (e.g. failed sign-in).
  userId String? @map("user_id")
  // Who performed it when acting on another user (admin actions).
  actorId String? @map("actor_id")

  // Email as submitted; kept for failed sign-ins against unknown accounts.
  email     String? @db.Citext
  ip        String?
  userAgent String? @map("user_agent")
  metadata  Json?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([type, createdAt])
  @@index([createdAt])
  @@map("auth_events")
}
