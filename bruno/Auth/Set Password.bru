meta {
  name: Set Password
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/set-password
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "token": "{{setPasswordToken}}",
    "password": "{{password}}"
  }
}

vars:pre-request {
  setPasswordToken: 
}
