meta {
  name: Sign In
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/sign-in
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "empleado@hotel.com",
    "password": "{{password}}"
  }
}

script:post-response {
  if (res.getStatus() === 200) {
    bru.setEnvVar("userId", res.getBody().data.id);
  }
}
