meta {
  name: Sign Up
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/sign-up
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "empleado@hotel.com",
    "password": "{{password}}"
  }
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setEnvVar("userId", res.getBody().data.id);
  }
}
