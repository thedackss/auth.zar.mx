meta {
  name: App Sign Up
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/app/sign-up
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-App-Key: {{appKey}}
  X-Client-IP: 203.0.113.9
  X-Client-User-Agent: Mozilla/5.0 (visitor)
}

body:json {
  {
    "email": "user@example.com",
    "password": "{{password}}",
    "lang": "en"
  }
}
